rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User data rule: Users can read/write their own data, Admin can write to anyone
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'memedkervanji@gmail.com');
    }
    
    // Leaderboard rule: Anyone can read, but only authenticated users can write (append only ideally, but write for now)
    match /leaderboard/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Alliances: anyone can read, only authenticated can write
    match /alliances/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin rewards: clients can read to claim rewards
    match /admin_rewards/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Arena champion banner: allow read/write for display and updates
    match /system/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // Default rule: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
